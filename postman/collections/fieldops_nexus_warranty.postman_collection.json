    {
      "name": "5. Live Coverage Evaluation",
      "item": [
        {
          "name": "5.1 Check Asset Coverage (Eligible - Corrective)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Organization",
                "value": "{{org_slug}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/coverage/?asset={{asset_id}}&work_type=CORRECTIVE&date=2026-10-06",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "coverage", ""],
              "query": [
                {
                  "key": "asset",
                  "value": "{{asset_id}}"
                },
                {
                  "key": "work_type",
                  "value": "CORRECTIVE"
                },
                {
                  "key": "date",
                  "value": "2026-10-06"
                }
              ]
            }
          }
        },
        {
          "name": "5.2 Check Asset Coverage (Excluded Work Type - Installation)",

    {
      "name": "4. Warranty & Coverage Agreements",
      "item": [
        {
          "name": "4.1 Create Warranty Agreement",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.environment.set('agreement_id', res.id);",
                  "    console.log('Agreement created with ID: ' + res.id);",
                  "}",
                  "pm.test('Warranty agreement created (201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(res.kind).to.eql('WARRANTY');",
                  "    pm.expect(res.state).to.eql('ACTIVE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Organization",
                "value": "{{org_slug}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"WARRANTY\",\n  \"reference\": \"WAR-2026-001\",\n  \"title\": \"OEM Comprehensive Manufacturer Warranty\",\n  \"provider\": \"{{provider_id}}\",\n  \"site\": \"{{site_id}}\",\n  \"start_date\": \"2026-01-01\",\n  \"end_date\": \"2027-12-31\",\n  \"assets\": [\n    \"{{asset_id}}\"\n  ],\n  \"terms\": \"Comprehensive parts and labor warranty against manufacturer defects.\",\n  \"exclusion_notes\": \"Excludes consumable fluids and accidental user damage.\",\n  \"renewal_alert_days\": 30,\n  \"excluded_work_types\": [\n    \"INSTALLATION\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/coverage-agreements/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "coverage-agreements", ""]
            }
          }
        },
        {
          "name": "4.2 List Agreements (Filter kind=WARRANTY)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Organization",
                "value": "{{org_slug}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/coverage-agreements/?kind=WARRANTY&state=ACTIVE",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "coverage-agreements", ""],
              "query": [
                {
                  "key": "kind",
                  "value": "WARRANTY"
                },
                {
                  "key": "state",
                  "value": "ACTIVE"
                }
              ]
            }
          }
        },

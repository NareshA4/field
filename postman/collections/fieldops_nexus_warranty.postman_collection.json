                  "if (Array.isArray(items) && items.length > 0) {",
                  "    pm.environment.set('site_id', items[0].id);",
                  "    console.log('Using Site ID: ' + items[0].id);",
                  "}",
                  "pm.test('Sites retrieved', function() {",
                  "    pm.response.to.have.status(200);",

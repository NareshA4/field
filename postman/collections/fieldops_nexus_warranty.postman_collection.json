{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
    "name": "FieldOps Nexus - Warranty & Coverage Module (M10)",
    "description": "API collection to test M10 Warranty, AMC, Service Contracts, Providers, and Live Coverage Eligibility evaluation in FieldOps Nexus.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Obtain JWT Token (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access) {",
                  "    pm.environment.set('access_token', res.access);",
                  "    console.log('Access token saved to environment.');",
                  "}",
                  "if (res.refresh) {",
                  "    pm.environment.set('refresh_token', res.refresh);",
                  "    console.log('Refresh token saved to environment.');",
                  "}",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token", ""]
            }
          }
        },
        {
          "name": "1.2 Refresh JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access) {",
                  "    pm.environment.set('access_token', res.access);",
                  "}",
                  "pm.test('Token refreshed successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token", "refresh", ""]
            }
          }
        },
        {
          "name": "1.3 Current User & Organizations (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me", ""]
            }
          }
        }
      ]
    },

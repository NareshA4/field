            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apex OEM Solutions\",\n  \"contact_name\": \"John Doe\",\n  \"email\": \"support@apexsolutions.example\",\n  \"phone\": \"+1-555-0199\",\n  \"notes\": \"Authorized warranty provider for primary machinery\"\n}"

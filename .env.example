# Copy to .env (never commit .env). Generate real values with scripts/bootstrap_env.py
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-use-scripts-bootstrap_env
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=

# PostgreSQL 15+
DATABASE_URL=postgres://fieldops:change-me@localhost:5432/fieldops
POSTGRES_DB=fieldops
POSTGRES_USER=fieldops
POSTGRES_PASSWORD=change-me

# Redis 7+
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Email (console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FieldOps Nexus <no-reply@fieldops.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Public base URL used in invitation emails
SITE_BASE_URL=http://localhost:8000

# Uploads
UPLOAD_MAX_BYTES=10485760
